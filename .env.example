# ---------------------------------------------------------------------------
# Elveth Group - production environment for the WordPress stack.
# Copy to .env on the server (/opt/elvethgroup/.env) and fill in real values.
# NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# --- Image (published by GitHub Actions to GitHub Container Registry) -------
IMAGE_NAME=ghcr.io/heiskevinmranda/elvethgroup-website
IMAGE_TAG=latest
PULL_POLICY=missing

# --- Host paths / ports ---------------------------------------------------
APP_DIR=/opt/elvethgroup
APP_PORT=8095
UPLOADS_DIR=/opt/elvethgroup/uploads

# --- Database -------------------------------------------------------------
DB_NAME=elvethgroupco_wp74
DB_USER=elvethgroupco_wp74
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me
DB_TABLE_PREFIX=wpmt_

# --- Site URL -------------------------------------------------------------
SITE_URL=https://elvethgroup.co.tz

# --- WordPress salts (generate with: wp-cli scaffold salts) ---------------
AUTH_KEY=change-me
SECURE_AUTH_KEY=change-me
LOGGED_IN_KEY=change-me
NONCE_KEY=change-me
AUTH_SALT=change-me
SECURE_AUTH_SALT=change-me
LOGGED_IN_SALT=change-me
NONCE_SALT=change-me
